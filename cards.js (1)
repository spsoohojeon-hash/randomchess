id==="kingReturn"){s.activeMode="kingReturn";return{ok:true,message:"왕의 귀환 발동!"}}return{ok:false,message:"알 수 없는 카드"}}export function getWildHorseMoves(r,c,b,color){const res=[];for(const[dr,dc]of[[3,2],[3,-2],[-3,2],[-3,-2],[2,3],[-2,3],[2,-3],[-2,-3]]){const nr=r+dr,nc=c+dc;if(nr<0||nr>7||nc<0||nc>7)continue;const t=b[nr][nc];if(!t||t[0]!==color)res.push({r:nr,c:nc,type:"normal"})}return res}